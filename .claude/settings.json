{
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(npm run tauri:*)",
      "Bash(node --check:*)",
      "Bash(node .claude/scripts/cambios.cjs:*)"
    ],
    "ask": [
      "Bash(node .claude/scripts/cambios.cjs aprobar:*)",
      "PowerShell(node .claude/scripts/cambios.cjs aprobar:*)"
    ],
    "deny": [
      "Edit(./.claude/cambios/**)",
      "Edit(./.claude/revisiones/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.cjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/escritura-docs.cjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/niega-aprobar.cjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/git-seguro.cjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sensible.cjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-code.cjs\""
          }
        ]
      }
    ]
  },
  "_LEEME": "Se versiona con el repo. Hooks: SessionStart inyecta el handoff; check-code valida sintaxis JS/shell al editar. Allowlist MODERADA: git local (SIN push — se pide permiso), cargo/npm de este stack, y lecturas frecuentes. Todo lo destructivo (reset, force-push, borrar) y el push quedan en 'preguntar'. Overrides personales van en settings.local.json (gitignored)."
}
